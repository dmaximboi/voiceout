NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
# Extra CORS origin only (tunnel hostname). Leave blank in production.
PUBLIC_ORIGIN=
API_PORT=4000
BACKEND_PORT=4001
PAYMENTS_PORT=4002
# NEVER reuse these token values in production. Mint new random strings.
ALGO_SERVICE_TOKEN=dev-algo-token-change-me
INTERNAL_SERVICE_TOKEN=dev-internal-token-change-me

# Local Docker defaults. Production: Neon owner URL for migrate; app-role pooler for runtime.
DATABASE_OWNER_URL=postgres://voiceout:voiceout@localhost:5432/voiceout
DATABASE_URL=postgres://voiceout:voiceout@localhost:5432/voiceout
DATABASE_APP_USER=voiceout_app
DATABASE_APP_PASSWORD=voiceout_app_local
REDIS_URL=redis://localhost:6379
# Production: Upstash rediss://… — keep workers light (see apps/backend REDIS_DRAIN_DELAY_MS)

COOKIE_SECRET=dev-cookie-secret-must-be-at-least-32-chars
JWT_SECRET=dev-jwt-secret-must-be-at-least-32-chars-long
JWT_SECRET_PREV=
JWT_ISS=voiceout
JWT_AUD=voiceout-api

# AES-256 key-encryption key (32+ chars). Required in production.
DATA_KEK=

KILL_UPLOADS=false
KILL_OAUTH=false
KILL_TRANSCRIBE=false

# Local MinIO. Production: Cloudflare R2 account endpoint + API token keys.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=voiceout
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio-secret
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

BACHS_API_KEY=
BACHS_WEBHOOK_SECRET=
BACHS_API_BASE=
# Optional Bachs product IDs (one per tier). Leave blank to use dynamic USD amounts.
BACHS_STUDIO_PRODUCT_ID=
BACHS_VERIFIED_PRODUCT_ID=
BACHS_GOLD_PRODUCT_ID=

RESEND_API_KEY=
MAIL_FROM=VoiceOut <noreply@localhost>
ADMIN_TOKEN=
# Comma-separated emails auto-promoted to admin on login (e.g. you@gmail.com)
ADMIN_EMAILS=
ADMIN_LAN_ONLY=

# Local only. Production MUST be false.
SKIP_MEDIA_PROBE=true
FFPROBE_PATH=ffprobe

NEXT_PUBLIC_API_URL=/vo-api
NEXT_PUBLIC_WEB_ORIGIN=http://localhost:3000

# Production hosts: Vercel web, Fly API, Render backend, Railway algo.
# Domain: https://voiceout.xyz — see docs/DEPLOY.md
