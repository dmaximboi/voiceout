# Local defaults work with: docker compose -f infra/docker-compose.yml up -d postgres redis minio minio-init
# Fill the PROVIDE THESE section when you deploy or want Google/Apple/email.

NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
# Extra CORS origin only (tunnel hostname). Do not use this as a stand-in for WEB_ORIGIN or API_ORIGIN.
PUBLIC_ORIGIN=
API_PORT=4000
BACKEND_PORT=4001
PAYMENTS_PORT=4002
# NEVER reuse these token values in production. Mint new random strings.
ALGO_SERVICE_TOKEN=dev-algo-token-change-me
INTERNAL_SERVICE_TOKEN=dev-internal-token-change-me

# After `pnpm db:gate`, switch DATABASE_URL to the locked app role (compose already does this).
DATABASE_OWNER_URL=postgres://voiceout:voiceout@localhost:5432/voiceout
DATABASE_URL=postgres://voiceout:voiceout@localhost:5432/voiceout
DATABASE_APP_USER=voiceout_app
DATABASE_APP_PASSWORD=voiceout_app_local
# After `pnpm db:gate`, DATABASE_URL becomes the locked app role. Keep DATABASE_OWNER_URL for migrations.
REDIS_URL=redis://localhost:6379

COOKIE_SECRET=dev-cookie-secret-must-be-at-least-32-chars
JWT_SECRET=dev-jwt-secret-must-be-at-least-32-chars-long
JWT_SECRET_PREV=
JWT_ISS=voiceout
JWT_AUD=voiceout-api

# AES-256 key-encryption key for per-user data keys (account erasure).
# Production: 32+ chars or 64 hex. Dev: omit and it is derived from JWT_SECRET.
DATA_KEK=

KILL_UPLOADS=false
KILL_OAUTH=false
KILL_TRANSCRIBE=false

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=voiceout
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio-secret
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000

# --- PROVIDE THESE when you are ready (leave blank to skip) ---
# Google Cloud → APIs & Services → Credentials → your OAuth client:
#   Authorized JavaScript origins:  http://localhost:3000
#   Authorized redirect URIs:       http://localhost:3000/auth/google/callback
# (Must match WEB_ORIGIN exactly. The old :4000/auth/google/callback URI will 400.)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

RESEND_API_KEY=
MAIL_FROM=VoiceOut <noreply@localhost>
ADMIN_TOKEN=

# Laptop only. Production MUST set SKIP_MEDIA_PROBE=false so ffprobe checks duration.
SKIP_MEDIA_PROBE=true
FFPROBE_PATH=ffprobe

# Browser calls same-origin /vo-api. WEB_ORIGIN is pages/emails/OAuth. API_ORIGIN is the Next server proxy target.
NEXT_PUBLIC_API_URL=/vo-api
NEXT_PUBLIC_WEB_ORIGIN=http://localhost:3000

# Full stack behind the reverse proxy (hides :3000/:4000/:5000):
# docker compose -f infra/docker-compose.yml up --build
# Then open http://localhost:2000  (host 2000 → gateway 2005 on app_net)

