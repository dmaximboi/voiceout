    "@fastify/rate-limit": "^10.2.1",
    "@voiceout/db": "workspace:*",
    "@voiceout/shared": "workspace:*",
    "hash-wasm": "^4.11.0",
    "bullmq": "^5.34.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2",
