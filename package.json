{
  "name": "voiceout",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:migrate": "pnpm --filter @voiceout/db migrate",
    "db:gate": "pnpm --filter @voiceout/db gate",
    "db:studio": "pnpm --filter @voiceout/db studio"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "prettier": "^3.4.2"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.28",
      "sharp": "0.35.4",
      "fast-uri@^3.0.0": "3.1.7",
      "fast-uri@^4.0.0": "4.1.4"
    }
  }
}
